# Copy to .env for local use. Do not commit .env.
STATICRYPT_PASSWORD=unicorn

# Google OAuth (Slides + Drive). See scripts/google/auth.js for setup steps.
# Option A: client ID + secret from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional if using a Web OAuth client instead of Desktop:
# GOOGLE_REDIRECT_URI=http://localhost:3456/oauth2callback

# Option B: path to downloaded OAuth client JSON (default: scripts/google/credentials.json)
# GOOGLE_CREDENTIALS_PATH=scripts/google/credentials.json
